# ==============================================================================
# 🚀 KIL LIBRARY - PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env on your Hostinger VPS
# ==============================================================================

# ----------------------------------------------------
# 1. Database (PostgreSQL inside Docker)
# ----------------------------------------------------
POSTGRES_USER=library_admin
POSTGRES_PASSWORD=your_super_secure_postgres_password_here_2026
POSTGRES_DB=library_production_db

# ----------------------------------------------------
# 2. Security & JWT Auth
# ----------------------------------------------------
# Generate a strong 64-char key: openssl rand -hex 32
SECRET_KEY=generate_a_very_long_and_secure_random_key_here_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ----------------------------------------------------
# 3. Cloudflare R2 Storage (Zero Egress - 10k+ Books & PDFs)
# ----------------------------------------------------
# Get these from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
# Public bucket domain or custom domain (e.g. https://pub-xyz.r2.dev or https://cdn.yourdomain.com)
R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev

# ----------------------------------------------------
# 4. Cloudinary (Optional fallback for images)
# ----------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----------------------------------------------------
# 5. Frontend & Domains
# ----------------------------------------------------
# Domain name or VPS IP (e.g., https://yourlibrarydomain.com)
DOMAIN_NAME=yourlibrarydomain.com
CORS_ORIGINS=http://localhost,https://localhost,https://yourlibrarydomain.com
TRUSTED_HOSTS=localhost,127.0.0.1,yourlibrarydomain.com

# Frontend API URL (leave /api for same-domain reverse proxy)
VITE_API_BASE_URL=/api
VITE_API_URL=/api
